{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeFriend",
  "version": "0.2.0",
  "identifier": "com.vibefriend.app",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "VibeFriend",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private, local-first activity tracker"
  }
}
